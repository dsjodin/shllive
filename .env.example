# Skapa en kopia av den här filen som ".env" och fyll i dina uppgifter.
# Registrera ett konto på https://openapi.shl.se för att få API-nycklar.

SHL_CLIENT_ID=din_client_id_här
SHL_CLIENT_SECRET=din_client_secret_här

# Säsong (2025 = säsong 2025/26)
SHL_SEASON=2025

# Port som applikationen exponeras på (default: 8080)
PORT=8080
